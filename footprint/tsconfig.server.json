{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "express"],
    "jsx": "preserve",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "server.ts",
    "src/server/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/pages",
    "src/components",
    "src/hooks",
    "src/context",
    "src/utils",
    "src/data",
    "src/pages/**/*",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/context/**/*",
    "src/utils/**/*",
    "src/data/**/*"
  ]
}